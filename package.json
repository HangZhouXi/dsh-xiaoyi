{
  "name": "dsh-xiaoyi",
  "version": "0.1.1",
  "description": "A DSH (DeepSeek Harness) host plugin that connects Huawei XiaoYi in OpenClaw mode to your local DSH session. Zero third-party dependencies, with a hand-written minimal RFC6455 WebSocket client.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "DISCLAIMER.md",
    "DISCLAIMER.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "plugin",
    "xiaoyi",
    "openclaw",
    "huawei",
    "a2a",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HangZhouXi/dsh-xiaoyi.git"
  },
  "homepage": "https://github.com/HangZhouXi/dsh-xiaoyi#readme",
  "bugs": {
    "url": "https://github.com/HangZhouXi/dsh-xiaoyi/issues"
  },
  "author": "HangZhouXi",
  "license": "MIT"
}
